FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive \
    HOME=/root \
    CARGO_HOME=/root/.cargo \
    RUSTUP_HOME=/root/.rustup \
    PATH=/root/.cargo/bin:${PATH}

RUN apt-get update && apt-get install -y software-properties-common \
    && add-apt-repository universe \
    && apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        cmake \
        gcc-aarch64-linux-gnu \
        g++-aarch64-linux-gnu \
        qemu-system-arm \
        qemu-utils \
        python3 \
        python3-pip \
        curl \
        ca-certificates \
        git \
        wget \
        xauth \
    && rm -rf /var/lib/apt/lists/*

RUN mkdir -p /opt/cross/bin && \
    printf '#!/bin/bash\nexec /usr/bin/aarch64-linux-gnu-gcc -march=armv8-a -ffreestanding -nostdlib "$@"\n' > /opt/cross/bin/aarch64-elf-gcc && \
    printf '#!/bin/bash\nexec /usr/bin/aarch64-linux-gnu-g++ -march=armv8-a -ffreestanding -nostdlib "$@"\n' > /opt/cross/bin/aarch64-elf-g++ && \
    printf '#!/bin/bash\nexec /usr/bin/aarch64-linux-gnu-gcc -march=armv8-a "$@"\n' > /opt/cross/bin/aarch64-elf-gcc-qt && \
    printf '#!/bin/bash\nexec /usr/bin/aarch64-linux-gnu-g++ -march=armv8-a "$@"\n' > /opt/cross/bin/aarch64-elf-g++-qt && \
    chmod +x /opt/cross/bin/aarch64-elf-gcc /opt/cross/bin/aarch64-elf-g++ /opt/cross/bin/aarch64-elf-gcc-qt /opt/cross/bin/aarch64-elf-g++-qt

ENV PATH=/opt/cross/bin:${PATH}

RUN curl -fsSL https://sh.rustup.rs | sh -s -- -y --default-toolchain nightly --profile minimal \
 && rustup component add rust-src rustfmt clippy \
 && rustup set auto-self-update disable

WORKDIR /workspace

COPY . /workspace

# hello and compositor are built by make userland during CI

CMD ["bash"]
